# Copy to .env.local if you need to override defaults. Local development values only — no secrets.
DATABASE_URL=postgres://venture_lab:venture_lab_local@127.0.0.1:5433/venture_lab
TEST_DATABASE_URL=postgres://venture_lab:venture_lab_local@127.0.0.1:5433/venture_lab_test
API_HOST=127.0.0.1
API_PORT=8787
# demo | real (default real). Overridden by ?mode= and the in-app switch.
VITE_DATA_MODE=real

# ---- VL-004B live providers (Yandex Search API + AI Studio). DISABLED by default. ----
# Never commit real values. Set secrets only in the execution host's secret store / shell, never in git or chat.
# Phase A (current): leave VL_LIVE_PROVIDER unset; only `--live --once --dry-run` is used (no network).
# VL_LIVE_PROVIDER=yandex
# YANDEX_FOLDER_ID=
# YANDEX_API_KEY=            # secret: service-account API key (or YANDEX_IAM_TOKEN instead)
# YANDEX_IAM_TOKEN=          # secret: short-lived IAM token (alternative to the API key)
# VL_ANALYST_MODEL=qwen3.6-35b-a3b
# VL_SKEPTIC_MODEL=deepseek-v4.1-flash
# VL_ALLOW_SINGLE_MODEL=false
# VL_LLM_RESPONSE_FORMAT=json_schema   # json_schema | json_object | none
# VL_LIVE_MAX_NEW=3
# VL_LIVE_MAX_RECHECKS=3
# VL_LIVE_CARRY_DAYS=7
# VL_LIVE_MONTHLY_BUDGET_KOP=40000     # application-side monthly cap (kopecks); NOT a billing guarantee
